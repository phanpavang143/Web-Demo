<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shop | Harvest &amp; Home</title><link rel="stylesheet" href="/resources/storefront.css"></head>
<body><header class="topbar"><a class="brand" href="/"><span class="brand-mark">+</span> Harvest &amp; Home</a><nav class="nav-links" aria-label="Main navigation"><a href="/">Home</a><a href="/profileDisplay">Profile</a><a href="/logout">Log out</a></nav></header>
<main class="page-width"><section class="hero" style="min-height:260px;padding-bottom:35px"><div><span class="eyebrow">The collection</span><h1 style="font-size:clamp(3rem,5vw,4.8rem)">A better kind of grocery run.</h1><p>Browse what is fresh, useful and ready for your table.</p></div><div class="hero-art" aria-hidden="true"></div></section>
<div class="section-heading"><h2>All products</h2><span class="form-note"><a href="/cart">View cart</a> &middot; Small choices, big difference.</span></div><c:choose><c:when test="${not empty products}"><div class="product-grid"><c:forEach var="product" items="${products}"><article class="product-card"><div class="product-image"><img src="${product.image}" alt="${product.name}"></div><div class="product-info"><h3>${product.name}</h3><p class="product-meta">${product.category.name}<br>${product.description}<br>Weight: ${product.weight} &middot; In stock: ${product.quantity}</p><span class="price">$${product.price}</span><form action="/cart/add" method="post" style="margin-top:14px"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="productId" value="${product.id}"><button class="button button-light" type="submit">Add to cart</button></form></div></article></c:forEach></div></c:when><c:otherwise><p class="form-note">${msg}</p></c:otherwise></c:choose></main>
<footer class="footer">Harvest &amp; Home &middot; Everyday goods, thoughtfully chosen.</footer></body></html>