<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Sign in | Harvest &amp; Home</title><link rel="stylesheet" href="/resources/storefront.css"></head>
<body><main class="auth-page"><aside class="auth-aside"><a class="brand" href="/" style="color:#fff"><span class="brand-mark" style="background:#f0b44d">+</span> Harvest &amp; Home</a><h1>Come on in.</h1><p>Keep your everyday essentials close and your shopping simple.</p></aside><section class="auth-form"><h2>Welcome back</h2><p class="intro">Sign in to continue to your account.</p><c:if test="${not empty msg}"><p class="alert">${msg}</p></c:if><form action="/userloginvalidate" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div class="field"><label for="username">Username</label><input id="username" name="username" type="text" required autocomplete="username"></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password"></div><button class="button" type="submit">Sign in</button></form><p class="form-note" style="margin-top:22px">New here? <a href="/register">Create an account</a></p></section></main></body></html>